# Public Supabase config (anon key is safe in the browser; RLS protects data).
# NEVER put the service-role key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# JSA Management (AI) — SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_.
# Required for AI generation; everything else works without it.
JSA_AI_API_KEY=
# anthropic (default) | openai (any OpenAI-compatible endpoint)
JSA_AI_PROVIDER=anthropic
# Optional overrides
# JSA_AI_MODEL=claude-sonnet-5-5
# JSA_AI_BASE_URL=

# Website quote requests (public coring-quote modal) — SERVER-SIDE ONLY.
# Emails are sent through Resend (https://resend.com).
RESEND_API_KEY=
QUOTE_TO_EMAIL=contact@hbcgcc.com
# Must be on a domain verified in Resend, e.g. HBC Website <quotes@hbcgcc.com>
QUOTE_FROM_EMAIL=

# Shared company inbox (contact@hbcgcc.com on IONOS) — SERVER-SIDE ONLY.
# Mail is read over IMAP and sent over SMTP. Administrators only.
MAIL_USER=contact@hbcgcc.com
# Mailbox password (or an app password if two-step login is on).
MAIL_PASSWORD=
# The company (uuid from the companies table) that owns this mailbox; other companies are refused.
MAIL_COMPANY_ID=
MAIL_FROM_NAME=HBC
# Defaults shown; change the host if your IONOS region differs (e.g. imap.ionos.co.uk, imap.ionos.de).
# MAIL_IMAP_HOST=imap.ionos.com
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtp.ionos.com
# MAIL_SMTP_PORT=587
