# Public Supabase config (anon key is safe in the browser; RLS protects data).
# NEVER put the service-role key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# JSA Management (AI) — SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_.
# Required for AI generation; everything else works without it.
JSA_AI_API_KEY=
# anthropic (default) | openai (any OpenAI-compatible endpoint)
JSA_AI_PROVIDER=anthropic
# Optional overrides
# JSA_AI_MODEL=claude-sonnet-5-5
# JSA_AI_BASE_URL=
